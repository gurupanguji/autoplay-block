{
  "manifest_version": 3,
  "name": "Local Autoplay Blocker",
  "version": "1.0",
  "description": "Forces all video elements to pause on load.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ]
}
